<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TituloPagina">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="SubtituloPagina">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gris</item>
    </style>

    <style name="Etiqueta">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/verde_oscuro</item>
    </style>

    <style name="BotonVerde" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/verde_oscuro</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="BotonBlanco" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/blanco</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="BotonBorde" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/borde</item>
        <item name="android:textColor">@color/texto</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Tarjeta">
        <item name="cornerRadius">14dp</item>
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>
