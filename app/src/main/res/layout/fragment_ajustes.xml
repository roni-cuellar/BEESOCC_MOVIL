<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_suave"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONFIGURACIÓN" />
        <TextView style="@style/TituloPagina" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajustes" />
        <TextView style="@style/SubtituloPagina" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:text="Cambia la URL del backend según el dispositivo que uses." />

        <com.google.android.material.card.MaterialCardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:contentPadding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/ajustesUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/ajustesCorreo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/gris" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ajustesSalir"
                    style="@style/BotonBorde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cerrar_sesion" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="URL BASE DE LA API" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ajustesUrlLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="http://10.0.2.2:8000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ajustesUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Emulador: http://10.0.2.2:8000\nCelular en la misma red: http://IP_DE_TU_PC:8000\nEl backend debe iniciarse con php artisan serve --host=0.0.0.0"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ajustesEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ajustesGuardar"
                    style="@style/BotonVerde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Guardar y probar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ajustesRestablecer"
                    style="@style/BotonBorde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Restablecer valor del proyecto" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
